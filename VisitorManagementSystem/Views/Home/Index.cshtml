@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 class="display-4"><i class="bi bi-person-badge"></i> Welcome to Visitor Management System</h1>
    <p class="lead">Efficiently manage your visitor check-ins and check-outs</p>
    <hr class="my-4" />
    <div class="row justify-content-center">
        <div class="col-md-3 mb-3">
            <a asp-controller="Visit" asp-action="Register" class="btn btn-primary btn-lg d-block">
                <i class="bi bi-plus-circle"></i> Register Visit
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-success btn-lg d-block">
                <i class="bi bi-speedometer2"></i> View Dashboard
            </a>
        </div>
        <div class="col-md-3 mb-3">
            <a asp-controller="Visit" asp-action="Index" class="btn btn-info btn-lg d-block">
                <i class="bi bi-clock-history"></i> Visit History
            </a>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-person-check fs-1 text-primary"></i>
                <h5 class="card-title mt-3">Quick Check-In</h5>
                <p class="card-text">Register visitors quickly with our easy-to-use check-in system.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-box-arrow-right fs-1 text-success"></i>
                <h5 class="card-title mt-3">Easy Check-Out</h5>
                <p class="card-text">Track visitor departures with seamless check-out process.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-graph-up fs-1 text-info"></i>
                <h5 class="card-title mt-3">Real-time Dashboard</h5>
                <p class="card-text">Monitor visitor activity with live dashboard statistics.</p>
            </div>
        </div>
    </div>
</div>
